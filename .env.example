# Database (PostgreSQL - Neon recommended)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"

# Email (Resend - https://resend.com)
RESEND_API_KEY="re_xxxxxxxx"
EMAIL_FROM="TicketBook <onboarding@resend.dev>"

# App
APP_URL="http://localhost:3000"

# Seat hold TTL in minutes (default: 10)
SEAT_HOLD_TTL_MINUTES=10

# Waitlist offer TTL in minutes (default: 15)
WAITLIST_OFFER_TTL_MINUTES=15

# Cron job authentication (set in Vercel env)
CRON_SECRET="change-me-cron-secret"
